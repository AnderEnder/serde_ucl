
            # Explicit array syntax
            explicit_array = ["item1", "item2"]
            
            # Implicit array through repetition
            implicit_array = "item1"
            implicit_array = "item2"
            
            # Mixed: start with explicit, extend with implicit
            mixed_array = ["initial1", "initial2"]
            mixed_array = "added1"
            mixed_array = "added2"
        