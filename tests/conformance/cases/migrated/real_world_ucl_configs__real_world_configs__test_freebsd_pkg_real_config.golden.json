{"t":"object","entries":[{"k":"name","v":[{"t":"string","v":"nginx"}]},{"k":"version","v":[{"t":"string","v":"1.20.1"}]},{"k":"origin","v":[{"t":"string","v":"www/nginx"}]},{"k":"comment","v":[{"t":"string","v":"Robust and small WWW server"}]},{"k":"desc","v":[{"t":"string","v":"Nginx (pronounced \"engine x\") is a free, open-source, high-performance HTTP\nserver and reverse proxy, as well as an IMAP/POP3 proxy server. Igor Sysoev\nstarted development of Nginx in 2002, with the first public release in 2004.\nNginx now hosts nearly 12.6% (22.2M) of active sites across all domains.\n\nNginx is known for its high performance, stability, rich feature set, simple\nconfiguration, and low resource consumption."}]},{"k":"maintainer","v":[{"t":"string","v":"demon@FreeBSD.org"}]},{"k":"www","v":[{"t":"string","v":"https://nginx.org/"}]},{"k":"arch","v":[{"t":"string","v":"FreeBSD:13:amd64"}]},{"k":"prefix","v":[{"t":"string","v":"/usr/local"}]},{"k":"deps","v":[{"t":"object","entries":[{"k":"pcre","v":[{"t":"object","entries":[{"k":"origin","v":[{"t":"string","v":"devel/pcre"}]},{"k":"version","v":[{"t":"string","v":"8.45"}]}]}]},{"k":"openssl","v":[{"t":"object","entries":[{"k":"origin","v":[{"t":"string","v":"security/openssl"}]},{"k":"version","v":[{"t":"string","v":"1.1.1k,1"}]}]}]},{"k":"zlib","v":[{"t":"object","entries":[{"k":"origin","v":[{"t":"string","v":"archivers/zlib"}]},{"k":"version","v":[{"t":"string","v":"1.2.11"}]}]}]}]}]},{"k":"files","v":[{"t":"object","entries":[{"k":"/usr/local/sbin/nginx","v":[{"t":"string","v":"sha256:a1b2c3d4e5f6..."}]},{"k":"/usr/local/etc/nginx/nginx.conf","v":[{"t":"string","v":"sha256:f6e5d4c3b2a1..."}]},{"k":"/usr/local/etc/nginx/mime.types","v":[{"t":"string","v":"sha256:1a2b3c4d5e6f..."}]},{"k":"/usr/local/www/nginx/index.html","v":[{"t":"string","v":"sha256:6f5e4d3c2b1a..."}]}]}]},{"k":"directories","v":[{"t":"object","entries":[{"k":"/usr/local/etc/nginx","v":[{"t":"bool","v":true}]},{"k":"/usr/local/www/nginx","v":[{"t":"bool","v":true}]},{"k":"/var/log/nginx","v":[{"t":"bool","v":true}]},{"k":"/var/run/nginx","v":[{"t":"bool","v":true}]}]}]},{"k":"scripts","v":[{"t":"object","entries":[{"k":"pre-install","v":[{"t":"string","v":"#!/bin/sh\nif ! pw groupshow www >/dev/null 2>&1; then\n    pw groupadd www -g 80\nfi\nif ! pw usershow www >/dev/null 2>&1; then\n    pw useradd www -u 80 -g www -d /nonexistent -s /usr/sbin/nologin\nfi"}]},{"k":"post-install","v":[{"t":"string","v":"#!/bin/sh\necho \"Nginx has been installed successfully.\"\necho \"Configuration files are in /usr/local/etc/nginx/\"\necho \"To start nginx: service nginx start\""}]}]}]},{"k":"options","v":[{"t":"object","entries":[{"k":"HTTP_SSL","v":[{"t":"bool","v":true}]},{"k":"HTTP_GZIP","v":[{"t":"bool","v":true}]},{"k":"HTTP_REWRITE","v":[{"t":"bool","v":true}]},{"k":"HTTP_REALIP","v":[{"t":"bool","v":true}]},{"k":"HTTP_STATUS","v":[{"t":"bool","v":false}]},{"k":"HTTP_DAV","v":[{"t":"bool","v":false}]},{"k":"MAIL","v":[{"t":"bool","v":false}]},{"k":"STREAM","v":[{"t":"bool","v":false}]}]}]},{"k":"categories","v":[{"t":"array","v":[{"t":"string","v":"www"},{"t":"string","v":"http"}]}]},{"k":"licenses","v":[{"t":"array","v":[{"t":"string","v":"BSD2CLAUSE"}]}]},{"k":"annotations","v":[{"t":"object","entries":[{"k":"repo_type","v":[{"t":"string","v":"binary"}]},{"k":"built_by","v":[{"t":"string","v":"poudriere-devel-3.3.0"}]},{"k":"build_timestamp","v":[{"t":"string","v":"1625097600"}]}]}]}]}
