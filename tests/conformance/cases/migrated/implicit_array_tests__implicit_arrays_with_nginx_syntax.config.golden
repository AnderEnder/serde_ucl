upstream {
    backend {
        server = "127.0.0.1:3000";
        server = "127.0.0.1:3001";
        server = "127.0.0.1:3002";
    }
}
server {
    listen = 80;
    listen = 443;
    location {
        / {
            proxy_pass = "http://backend";
        }
    }
    location {
        /api {
            proxy_pass = "http://api_backend";
        }
    }
}
