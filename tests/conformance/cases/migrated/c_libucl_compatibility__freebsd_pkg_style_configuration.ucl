
            name = "testpackage";
            version = "1.0.0";
            origin = "local/testpackage";
            comment = "Test package";
            
            deps {
                python38 {
                    origin = "lang/python38";
                    version = "3.8.12";
                }
            }
            
            files {
                "/usr/local/bin/test" = "checksum1";
                "/usr/local/etc/test.conf" = "checksum2";
            }
            
            options {
                SSL = "on";
                IPV6 = "off";
            }
        