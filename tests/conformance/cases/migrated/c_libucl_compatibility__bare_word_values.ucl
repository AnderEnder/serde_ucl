
            # Boolean keywords
            enabled = true;
            disabled = false;
            active = yes;
            inactive = no;
            power = on;
            standby = off;
            
            # Null value
            empty = null;
            
            # Special float values
            infinity = inf;
            negative_infinity = -inf;
            not_a_number = nan;
            
            # Regular bare words (should be strings)
            environment = production;
            mode = debug;
        