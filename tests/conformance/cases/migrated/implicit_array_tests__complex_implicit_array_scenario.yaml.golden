upstream: {
    api_servers: {
        server: [
            "10.0.1.10:3000 weight=3",
            "10.0.1.11:3000 weight=2",
            "10.0.1.12:3000 weight=1",
            "10.0.1.13:3000 backup"
        ]
    }
}
server: {
    listen: [        80,
        "443 ssl"],
    server_name: [
        "api.example.com",
        "www.api.example.com"
    ],
    location: [
        {
            /v1: {
                proxy_pass: "http://api_servers",
                proxy_set_header: [
                    "Host $host",
                    "X-Real-IP $remote_addr"
                ]
            }
        },
        {
            /v2: {
                proxy_pass: "http://api_servers",
                proxy_set_header: "Host $host"
            }
        }
    ],
    ssl_certificate: "/path/to/cert.pem",
    ssl_certificate_key: "/path/to/key.pem",
    ssl_protocols: [
        "TLSv1.2",
        "TLSv1.3"
    ]
}