
        # Array format compatibility tests
        arrays = {
            # Simple array
            simple = ["item1", "item2", "item3"];
            
            # Array with trailing comma
            trailing_comma = [
                "item1",
                "item2",
                "item3",
            ];
            
            # Mixed type array
            mixed = [1, "string", true, 3.14];
            
            # Nested arrays
            nested = [
                ["a", "b"],
                ["c", "d"],
                [1, 2, 3]
            ];
            
            # Array of objects
            objects = [
                { name = "obj1", value = 1 },
                { name = "obj2", value = 2 }
            ];
        }
        
        # Multiple assignment to create array (UCL feature)
        multi_assign = "value1";
        multi_assign = "value2";
        multi_assign = "value3";
    